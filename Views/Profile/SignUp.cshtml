@using ComFlight.ViewModels;


@model RegisterModel
@{
    ViewData["Title"] = "SignUp";
}


<!DOCTYPE html>
<html>
<head>
    <title>Форма регистрации</title>
    <style>
        .forform {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .registration-form {
            background-color: #f0f0f0;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.3);
            justify-content: center;
            align-items: center;
            max-width:400px;
            margin:0 auto;
        }

        h2 {
            text-align: center;
        }

        .div {
            margin-bottom: 10px;
            align-items: center;
        }

        label {
            display: inline-block;
            width: 100px;
        }

        input[type="text"], input[type="password"] {
            width: 200px;
            padding: 5px;
            border-radius: 5px;
            border: none;
            box-shadow: inset 0 0 5px rgba(0,0,0,0.3);
        }

        input[type="submit"] {
            background-color: #058af7;
            color: #fff;
            border: none;
            border-radius: 5px;
            padding: 10px 20px;
            cursor: pointer;
        }
        .button-wrapper{
            text-align:center;
        }
    </style>
</head>
@Html.Partial("Pattern")
<body>

    <form class="registration-form" asp-controller="profile" asp-action="SignUp" method="post" asp-antiforgery="true">
        <h2>Регистрация</h2>
        <div class="validation">
            <label asp-for="Name">Имя:</label>
            <input type="text" asp-for="Name">
            <span asp-validation-for="Name" />
        </div>
        <div class="div">
            <label asp-for="Login">Логин:</label>
            @*@Html.TextBoxFor(model => model.Login, new { id = "username", required = "required" })*@
            <input type="text" asp-for="Login">
            <span asp-validation-for="Login"/>
        </div>
        <div class ="div">
            <label asp-for="Password">Пароль:</label>
            @*@Html.TextBoxFor(model => model.Password, new { type="password",id = "pass", required = "required",name="password" })*@
           <input asp-for="Password">
           <span asp-validation-for="Password"/>
        </div>
        <div class="div">
            <label asp-for="ConfirmPassword">Подтвердите пароль:</label>
            <input asp-for="ConfirmPassword"/>
            <span asp-validation-for="ConfirmPassword" />
        </div>
        @if (Model != null)
        {
            <div class="text-danger">
                @Html.ValidationSummary()
            </div>
        }
        <div class="button-wrapper">
            <input type="submit" value="Зарегистрироваться">
        </div>
    </form>
</body>
</html>
