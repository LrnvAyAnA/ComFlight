                    down: 'fas fa-chevron-down', // Иконка уменьшения
                    previous: 'fas fa-chevron-left', // Иконка предыдущего периода
                    next: 'fas fa-chevron-right', // Иконка следующего периода
                    today: 'fas fa-calendar-check', // Иконка "Сегодня"
                    clear: 'fas fa-trash', // Иконка "Очистить"
