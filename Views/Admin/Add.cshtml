        @*Добавление самолета*@
        <script>
            var planeModal = document.getElementById("planeModal");
            var closeButtonPlane = document.querySelector("#planeModal .close");
            var numderOfSeats = document.getElementById('numderOfSeats');

            // Назначаем обработчик события ввода
            // Получаем введенное значение
            // Удаляем все символы, кроме цифр
            // Устанавливаем отфильтрованное значение обратно в поле ввода

            numderOfSeats.addEventListener('input', function () {
                
                var numderOfSeatsV = numderOfSeats.value;
                
                var filteredValue = numderOfSeatsV.replace(/\D/g, '');
               
                numderOfSeats.value = filteredValue;
            });
            var numderOfRow = document.getElementById('numderOfRow');

            // Назначаем обработчик события ввода
            numderOfRow.addEventListener('input', function () {
                // Получаем введенное значение
                var numderOfRowV = numderOfRow.value;

                // Удаляем все символы, кроме цифр
                var filteredValue = numderOfRowV.replace(/\D/g, '');

                // Устанавливаем отфильтрованное значение обратно в поле ввода
                numderOfRow.value = filteredValue;
            });
            // Открытие модального окна
            function openPlaneModal() {
                planeModal.style.display = "block";
            }

            var addPlaneButton = document.getElementById("addPlaneButton");
            addPlaneButton.addEventListener("click", function () {
                // Получаем поле ввода по его идентификатору
                
                var modelInput = document.getElementById("modelPlane");
                var model = modelInput.value;
                var dateManufactureInput = document.getElementById("dateManufacture");
                var dateManufacture = dateManufactureInput.value;
                var numderOfSeatsInput = document.getElementById("numderOfSeats");
                var numderOfSeats = numderOfSeatsInput.value;
