                var numderOfRow = numderOfRowInput.value;
                var plane = {
                    Model: model,
                    DateOfManufacture: dateManufacture,
                    Seats: numderOfSeats,
                    numOfRow: numderOfRow
                };
                console.log(plane)
                var combinedModel = {
                    AirplaneModel: plane
                };

                $.ajax({
                    url: "/Admin/AddPlane",
                    type: "POST",
                    data: JSON.stringify(combinedModel),
                    contentType: "application/json",
                    dataType: "json",
                    success: function (result) {
                        // Обработка успешного ответа от сервера
                        alert(result.message);
