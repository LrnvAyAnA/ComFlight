        @*Добавление рейса*@
        <script>
            var flightModal = document.getElementById("flightModal");
            var closeButtonFlight = document.querySelector("#flightModal .close");
            var Price = document.getElementById('Price');

            // Назначаем обработчик события ввода
            Price.addEventListener('input', function () {
                // Получаем введенное значение
                var PriceV = Price.value;

                // Удаляем все символы, кроме цифр
                var filteredValue = PriceV.replace(/\D/g, '');

                // Устанавливаем отфильтрованное значение обратно в поле ввода
                Price.value = filteredValue;
            });
            // Открытие модального окна
            function openFlightModal() {
                flightModal.style.display = "block";
            }

            // Закрытие модального окна при нажатии на кнопку закрытия
            closeButtonFlight.addEventListener("click", function () {
                flightModal.style.display = "none";
            });

            //////Обработка для выбора города
            $(document).ready(function () {
                $.ajax({
                    url: '/SearchTicket/GetPlanes', // Путь к обработчику поискового запроса на сервере
                    type: 'GET',
                    success: function (response) {
                        var searchResults = response; // Полученные результаты поиска
                        $('#aircraft-list').empty();
                        // Добавляем результаты в список
                        $.each(searchResults, function (index, result) {
                            if (result) {
                                $('#aircraft-list').append('<option>' + result.model + '</option>');
                            }
                        });

                        // Показываем или скрываем список результатов в зависимости от наличия результатов
                    },
                    error: function (xhr, status, error) {
                        // Обработка ошибок при выполнении запроса
                        console.error('Ошибка AJAX-запроса:', error);
                    }
                });
            });
            $(document).ready(function () {
                $.ajax({
                    url: '/SearchTicket/GetAirlines', // Путь к обработчику поискового запроса на сервере
                    type: 'GET',
                    success: function (response) {
                        var searchResults = response; // Полученные результаты поиска
                        $('#airlineForFlight').empty();
                        // Добавляем результаты в список
                        $.each(searchResults, function (index, result) {
                            if (result) {
                                $('#airlineForFlight').append('<option>' + result.name + '</option>');
                            }
                        });
                        // Показываем или скрываем список результатов в зависимости от наличия результатов
                    },
                    error: function (xhr, status, error) {
                        // Обработка ошибок при выполнении запроса
                        console.error('Ошибка AJAX-запроса:', error);
                    }
                });
            });
            $(document).ready(function () {
                $.ajax({
                    url: '/SearchTicket/GetRoutes', // Путь к обработчику поискового запроса на сервере
                    type: 'GET',
                    success: function (response) {
                        var searchResults = response; // Полученные результаты поиска
                        $('#routeForFlight').empty();
                        // Добавляем результаты в список
                        $.each(searchResults, function (index, result) {
                            if (result) {
                                $('#routeForFlight').append('<option>' + result + '</option>');
                            }
                        });

                        // Показываем или скрываем список результатов в зависимости от наличия результатов
                    },
                    error: function (xhr, status, error) {
                        // Обработка ошибок при выполнении запроса
                        console.error('Ошибка AJAX-запроса:', error);
                    }
                });
            });
            // Обработка нажатия кнопки "Добавить маршрут"
            var addRouteButton = document.getElementById("addFlightButton");
            addRouteButton.addEventListener("click", function () {
                var timeFromInput = document.getElementById("datetimepickerFrom");
                var timeFrom = timeFromInput.value;
                var timeToInput = document.getElementById("datetimepickerTo");
                var timeTo = timeToInput.value;
                var airlineInput = document.getElementById("airlineForFlight");
                var airline = airlineInput.value;
                var routeInput = document.getElementById("routeForFlight");
                var route = routeInput.value;
                var planeInput = document.getElementById("aircraft-list");
                var plane = planeInput.value;
                var priceInput = document.getElementById("Price");
                var price = priceInput.value;
                var flight = {
                    Airline: airline,
                    dateOfDeparture: timeFrom,
                    dateOfDestination: timeTo,
                    Route:route,
                    Plane:plane,
                    Price:price
                };
                var combinedModel = {
                    FlightModel: flight
                };

                $.ajax({
                    url: "/Admin/AddFlight",
                    type: "POST",
                    data: JSON.stringify(combinedModel),
                    contentType: "application/json",
                    dataType: "json",
                    success: function (result) {
                        // Обработка успешного ответа от сервера
                        alert(result.message);
                        location.reload(true);
                    },
                    error: function (xhr, status, error) {
                        // Обработка ошибки
                        if (xhr.status !== 200) {
                            var errorMessage = xhr.responseText;
                            alert('Произошла ошибка при добавлении рейса: ' + errorMessage);
                        }

                    }
                });
            });
            $(function () {
                $('#datetimepickerFrom').datetimepicker({
                    format: 'YYYY-MM-DD HH:mm', // Формат даты и времени
