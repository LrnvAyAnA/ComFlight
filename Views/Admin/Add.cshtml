                    },
                    error: function (xhr, status, error) {
                        // Обработка ошибки
                        if (xhr.status !== 200) {
                            var errorMessage = xhr.responseText;
                            alert('Произошла ошибка при добавлении самолета: ' + errorMessage);
                        }

                    }
                });
            });

            // Закрытие модального окна при нажатии на кнопку закрытия
